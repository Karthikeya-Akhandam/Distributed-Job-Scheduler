# ============================================================
# Distributed Job Scheduler — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.
# ============================================================

# ── General ──────────────────────────────────────────────────
APP_NAME=distributed-job-scheduler
APP_ENV=development
DEBUG=true

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_scheduler
POSTGRES_USER=scheduler_user
POSTGRES_PASSWORD=scheduler_secret_password

# Constructed DATABASE_URL (used by backend & worker)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Worker ───────────────────────────────────────────────────
WORKER_ID=worker-1
WORKER_MAX_CONCURRENCY=10
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# ── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ── AI Failure Summaries ────────────────────────────────────
# Provider: "gemini" or "mock"
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
